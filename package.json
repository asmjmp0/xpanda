{
  "name": "xpanda",
  "version": "2.1.0",
  "private": true,
  "description": "xpanda monorepo - pure TypeScript implementation of the HarmonyOS .abc (Panda bytecode) decompiler",
  "workspaces": [
    "packages/xpanda-core",
    "packages/xpanda-cli",
    "packages/xpanda-mcp"
  ],
  "scripts": {
    "gen:opcodes": "npm run gen:opcodes --workspace xpanda-core",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:mcp": "npm run test:mcp --workspace xpanda-mcp",
    "mcp": "npm run mcp --workspace xpanda-mcp",
    "xpanda": "npm run xpanda --workspace xpanda-cli"
  }
}
