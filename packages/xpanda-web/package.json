{
  "name": "@asm-xpanda/web",
  "version": "2.8.2",
  "publishConfig": {
    "access": "public"
  },
  "description": "xpanda web - browser-based decompiler UI for HarmonyOS .abc / .hap files, pure frontend (React + esbuild)",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "preview": "esbuild --servedir=dist",
    "deploy": "bash scripts/deploy.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@asm-xpanda/core": "*",
    "fflate": "^0.8.3",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "shiki": "^4.5.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.3.3"
  }
}
